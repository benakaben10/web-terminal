# Copy to .env and edit before `docker compose up -d`.

# Login for the web UI. Leave WT_PASSWORD empty ONLY if the port is not
# reachable from anywhere untrusted — an empty password disables auth entirely.
WT_USERNAME=admin
WT_PASSWORD=change-me-please

# Branding shown in the tab title and on the login screen.
WT_TITLE=Web Terminal

# Container hostname, i.e. what the zsh prompt shows.
WT_HOSTNAME=web-terminal

# oh-my-zsh theme. "powerlevel10k/powerlevel10k" is also bundled.
WT_ZSH_THEME=robbyrussell

# Max concurrent shells.
WT_MAX_SESSIONS=12

# Timezone inside the container.
WT_TZ=Asia/Ho_Chi_Minh
